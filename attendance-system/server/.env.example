# Server configuration
PORT=5000

# Leave MONGODB_URI empty to use the built-in in-memory MongoDB (demo mode).
# For a persistent database use e.g.:
# MONGODB_URI=mongodb://127.0.0.1:27017/attendance
MONGODB_URI=

# Change this before deploying anywhere real.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Default teacher/admin account (created on first boot)
ADMIN_NAME=Admin Teacher
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Attendance rules
DEFAULT_CLASS_START_TIME=08:00
DEFAULT_LATE_GRACE_MINUTES=0

# Seed 10 demo students when the database is empty (set to false to skip)
AUTO_SEED=true

# Demo only: shift the server clock forward by N minutes so the late flow can be
# shown outside class hours. Leave 0 for normal behaviour.
APP_TIME_OFFSET_MINUTES=0
